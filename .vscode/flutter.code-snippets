  "application bloc ( method )": {
    "prefix": "application-bloc-method",
    "body": [
      "LoaderBloc loaderBloc = ref.read(loaderBlocProvider.notifier);",
      "    ErrorBloc errorBloc = ref.read(errorBlocProvider.notifier);",
      "    ${1:NameSensitive}Service ${2:nameSensitive}Service =",
      "        ref.read(${2:nameSensitive}ServiceProvider);",
      "    print(\"START\");",
      "",
      "    loaderBloc",
      "        .whileLoading(() => ${2:nameSensitive}Service.${3:methodName})",
      "        .then((value) {",
      "      value.when(success: (data) async {",
      "        print(data);",
      "      }, failure: (error) {",
      "        errorBloc.handle(error);",
      "      });",
      "    });"
    ],
