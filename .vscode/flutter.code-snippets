{
  "infrastructure data transfer object (DTO)": {
    "prefix": "infra-dto",
    "body": [
      "import 'dart:convert';",
      "",
      "import 'package:freezed_annotation/freezed_annotation.dart';",
      "",
      "part '${1:model}_dto.freezed.dart';",
      "part '${1:model}_dto.g.dart';",
      "",
      "@freezed",
      "class ${2:Model}DTO with _$${2:Model}DTO {",
      "  const factory ${2:Model}DTO({",
      "    String? data,",
      "  }) = _${2:Model}DTO;",
      "",
      "  factory ${2:Model}DTO.fromJson(Map<String, dynamic> json) =>",
      "      _$${2:Model}DTOFromJson(json);",
      "}",
      ""
    ],
    "description": "infrastructure data transfer object (DTO)"
  },
  "infrastructure dto init nested object": {
    "prefix": "infra-dto-init-nested-object",
    "body": [
      "@JsonKey(name: '${1:json_name}', fromJson: ${2:CurrentClassName}DTO._${3:objectName}FromJson, toJson: ${2:CurrentClassName}DTO._${3:objectName}ToJson) ${4:ChildClassName}DTO? ${3:objectName},"
    ],
    "description": "infrastructure dto nested object"
  },
  "infrastructure dto define nested object": {
    "prefix": "infra-dto-define-nested-object",
    "body": [
      "static ${1:ChildClassName}DTO? _${2:objectName}FromJson(Map<String, dynamic>? json) {",
      "  if (json == null) return null;",
      "  return ${1:ChildClassName}DTO.fromJson(json);",
      "}",
      "",
      "static Map<String, dynamic>? _${2:objectName}ToJson(${1:ChildClassName}DTO? ${2:objectName}) {",
      "  if (${2:objectName} == null) return null;",
      "  return ${2:objectName}.toJson();",
      "}"
    ],
    "description": "infrastructure dto define nested object"
  },
  "infrastructure dto init nested array": {
    "prefix": "infra-dto-init-nested-array",
    "body": [
      "@JsonKey(name: '${1:json_name}') @Default([]) List<${1:ChildClassName}>? data,"
    ],
    "description": "infrastructure dto init nested array"
  },
  "infra-dto-jsonserializeble": {
